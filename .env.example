# ============================================================
# VEYLO — LOCAL DEVELOPMENT ENVIRONMENT (safe placeholders)
# Copy to `.env` and adjust. Never commit `.env`.
# ============================================================

APP_ENV=development

# --- Ports ---
WEB_PORT=3000
API_PORT=8080

# --- Database (Docker Compose defaults) ---
POSTGRES_USER=veylo
POSTGRES_PASSWORD=veylo_local_dev
POSTGRES_DB=veylo
DATABASE_URL=postgres://veylo:veylo_local_dev@localhost:5432/veylo?sslmode=disable
DATABASE_URL_TEST=postgres://veylo:veylo_local_dev@localhost:5432/veylo_test?sslmode=disable

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Secrets (generate your own for local use, e.g. `openssl rand -hex 32`) ---
APP_ENCRYPTION_KEY=replace-with-random-32-byte-hex
SESSION_SECRET=replace-with-random-32-byte-hex

# --- Local SMTP (Mailpit) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Veylo <no-reply@veylo.local>
MAILPIT_WEB_URL=http://localhost:8025

# --- URLs ---
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080

# --- Media storage ---
STORAGE_PATH=./storage/uploads
MAX_ATTACHMENT_SIZE_MB=25

# --- Demo data (seed script only; development accounts, not production) ---
DEMO_SEED=false
